<?xml version="1.0" encoding="utf-8"?>
<!-- PdfReader makes no network requests. Deny cleartext everywhere and trust
     only system CAs (never user-installed CAs), in case any code ever tries. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
